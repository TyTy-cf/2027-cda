DELIMITER //
DROP PROCEDURE IF EXISTS insertOrder //
CREATE PROCEDURE insertOrder(idUser INT, idScreening INT, idSeat INT)
BEGIN
    START TRANSACTION;

	INSERT INTO `order` (created_at, user_id) VALUES (NOW(), idUser);
    SET @idOrder = LAST_INSERT_ID();

    INSERT INTO ticket (code, created_at, order_id, screening_id, seat_id) VALUES (CONCAT("TCK-", idScreening, "-", idSeat), NOW(), @idOrder, idScreening, idSeat);

	COMMIT;
END //
DELIMITER ;

