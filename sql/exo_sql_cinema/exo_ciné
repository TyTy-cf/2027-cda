DELIMITER //
DROP PROCEDURE IF EXISTS getOrderTotal //
CREATE PROCEDURE getOrderTotal(iOrder INT)
BEGIN
       SELECT CONCAT(FORMAT(SUM(r.price) / 100, 2, 'fr_FR'), '€')
       FROM `order`
       JOIN ticket t ON t.order_id = `order`.id
       JOIN screening sc ON sc.id = t.screening_id
       JOIN room r ON r.id = sc.room_id
       WHERE `order`.id = iOrder;
END //
DELIMITER ;

