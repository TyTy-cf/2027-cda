DELIMITER //
DROP PROCEDURE IF EXISTS getAvailableSeats //
CREATE PROCEDURE getAvailableSeats(IN iScreening INT)
BEGIN
    SET @allSeat = (
      	SELECT COUNT(se.id)
        FROM seat se
        JOIN room r ON r.id = se.room_id
        JOIN screening sc ON sc.room_id = r.id
        WHERE sc.id = iScreening
    );

    SELECT @allSeat - COUNT(*) AS available_seats
    FROM ticket t
    WHERE t.screening_id = iScreening;
END //
DELIMITER ;

