DELIMITER //
DROP PROCEDURE IF EXISTS getavailableSeats //
CREATE PROCEDURE getavailableSeats(screeningId INT)
BEGIN
    SELECT s.id, s.row, s.number
    FROM seat s
    JOIN room r ON r.id = s.room_id
    JOIN screening scr ON scr.room_id = r.id
    RIGHT JOIN ticket t ON t.seat_id = s.id
    WHERE scr.id = screeningId
        AND t.id IS NULL;
END //
DELIMITER ;

